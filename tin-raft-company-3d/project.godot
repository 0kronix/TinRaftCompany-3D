; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tin Raft Company 3D"
run/main_scene="res://scenes/network/lobby.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[audio]

buses/default_bus_layout="uid://dxxyvc4ceh7ni"
driver/enable_input=true
driver/mix_rate=48000

[autoload]

UIManager="*res://autoload/ui_manager.gd"
SettingsManager="*uid://bp1qg1u8t8iqu"
GameServices="*res://autoload/game_services.gd"
NetworkManager="*res://network/core/network_manager.gd"
FrameSpikeProbe="*res://debug/frame_spike_probe.gd"
WalkPerfProbe="*res://debug/walk_perf_probe.gd"
VoiceManager="*uid://cqxnacqv72yvo"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[frame_debug]

log_spikes=false
spike_threshold_ms=32.0
spike_cooldown_ms=400.0
walk_perf_log=true
walk_perf_interval_sec=2.0
walk_perf_sample_cap=600
walk_perf_sections=true

